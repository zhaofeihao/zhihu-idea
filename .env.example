# Node.js 24；复制为 .env 后填写。不要把密钥发到日志或提交到 Git。
DATABASE_URL=
# 连接需要校验证书；可选 Supabase 根证书路径。
DATABASE_CA_FILE=
ZHIHU_ACCESS_SECRET=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# 使用账号当前可用模型；两个阶段可分别使用 deepseek / openai。
SCREEN_PROVIDER=deepseek
SCREEN_MODEL=
ANALYZE_PROVIDER=deepseek
ANALYZE_MODEL=
# 可选官方/自有代理 URL，不填即使用提供商默认地址。
DEEPSEEK_BASE_URL=
OPENAI_BASE_URL=
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
RADAR_NAMESPACE=personal
